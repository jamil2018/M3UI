{
  "name": "@m3ui/storybook",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "storybook dev -p 6006",
    "build": "storybook build -o storybook-static",
    "preview": "http-server storybook-static -p 6006 -c-1",
    "stories:generate": "node scripts/generate-stories.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@m3ui/color": "workspace:*",
    "@m3ui/examples": "workspace:*",
    "@m3ui/icons": "workspace:*",
    "@m3ui/motion": "workspace:*",
    "@m3ui/react": "workspace:*",
    "@m3ui/shapes": "workspace:*",
    "@m3ui/tokens": "workspace:*",
    "motion": "^14.14.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "^10.6.7",
    "@storybook/addon-docs": "^10.6.7",
    "@storybook/react": "^10.6.7",
    "@storybook/react-vite": "^10.6.7",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "http-server": "^14.1.1",
    "storybook": "^10.6.7",
    "typescript": "^5.9.3",
    "vite": "^8.3.8"
  }
}
