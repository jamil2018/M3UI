{
  "name": "material-react",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "packageManager": "pnpm@10.34.7",
  "engines": {
    "node": ">=24.15.0"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:a11y": "turbo run test:a11y",
    "test:vrt": "pnpm build && playwright test",
    "spec:sync": "pnpm --filter @m3ui/spec-sync sync",
    "spec:sync:check": "pnpm --filter @m3ui/spec-sync check",
    "spec:parity": "pnpm --filter @m3ui/spec-sync parity",
    "spec:parity:check": "pnpm --filter @m3ui/spec-sync check:parity",
    "parity:check": "pnpm spec:parity:check",
    "parity:gates": "tsx tools/bundle-budget/gates.ts",
    "tokens:import:figma": "pnpm --filter @m3ui/spec-sync import:figma",
    "size:check": "tsx tools/bundle-budget/check.ts",
    "tokens:codegen": "pnpm --filter @m3ui/tokens codegen",
    "catalog:build": "turbo run catalog:build --filter=@m3ui/react",
    "registry:build": "pnpm catalog:build",
    "changeset": "changeset",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build:packages": "turbo run build --filter=\"./packages/*\"",
    "dev:docs": "turbo run dev --filter=@m3ui/docs...",
    "dev:storybook": "turbo run dev --filter=@m3ui/storybook...",
    "check": "pnpm test:dependencies && turbo run lint typecheck test test:a11y",
    "test:watch": "turbo run stories:generate --filter=@m3ui/storybook && vitest",
    "test:vrt:docs": "turbo run build --filter=@m3ui/docs... && playwright test --config playwright.docs.config.ts",
    "test:dependencies": "node --test scripts/dependency-security.test.mjs"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.65.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.14.0",
    "jsdom": "^30.1.3",
    "prettier": "^3.10.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tsx": "^4.23.15",
    "turbo": "^2.11.11",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0",
    "vitest-axe": "^0.1.0"
  },
  "pnpm": {
    "overrides": {
      "react": "19.3.1",
      "react-dom": "19.3.1",
      "brace-expansion@>=1 <2": "^1.1.21",
      "brace-expansion@>=5 <6": "^5.0.12",
      "source-map-js@>=1 <1.2.2": "^1.2.2",
      "minimatch@>=7 <11.0.1": "^11.0.1",
      "glob@>=9 <14.0.2": "^14.0.6"
    }
  }
}
